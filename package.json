{
  "name": "pro-cards",
  "version": "3.1.0-beta.1",
  "description": "Pro Cards – beautiful, customizable cards for Home Assistant dashboards",
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "dashboard",
    "custom-card"
  ],
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Malte Wessel",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.ts",
    "watch": "node build.ts --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:og": "node scripts/og.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=integration",
    "test:visual": "sh scripts/visual.sh",
    "test:visual:update": "sh scripts/visual.sh --update-snapshots",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "ha": "sh scripts/ha.sh",
    "ha:stop": "sh scripts/ha.sh stop",
    "ha:reset": "sh scripts/ha.sh reset",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:visual",
    "check": "npm run check:fast && npm run test:e2e && npm run check:docs",
    "check:docs": "npm run docs:build && npm run test:docs",
    "check:fast": "node scripts/parallel.mjs format:check lint typecheck && npm run build && npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "codemirror": "6.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "home-assistant-js-websocket": "^9.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.2",
    "lint-staged": "^17.5.1",
    "markdown-it-container": "^4.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,mjs,ts,mts}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "overrides": {
    "@lezer/common": "1.5.3",
    "@lezer/lr": "1.4.11"
  }
}
