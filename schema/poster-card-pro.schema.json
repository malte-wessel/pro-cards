{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malte-wessel.github.io/pro-cards/schema/poster-card-pro.schema.json",
  "title": "custom:poster-card-pro",
  "description": "One entity (or none) as a poster, drawn the way its poster type says: the lead and the badges on top, the name, the large value and the picture at the bottom, a backdrop behind. The poster type is detected from the entity (its domain, then its device class) or set with `poster`; its own keys (`variant`, the entities it reads, `running_above`, `series`) sit flat on the card and never decide the type. Strings containing {{ }} are Jinja templates rendered by Home Assistant (name, secondary, icon, color, value, status, image).",
  "type": "object",
  "properties": {
    "type": {
      "const": "custom:poster-card-pro"
    },
    "poster": {
      "description": "The poster type, forced or one that is never detected (trend, grid, solar, car, appliance). Left out: detected from the entity's domain and device class; `entity` turns every default off",
      "$ref": "#/$defs/posterType"
    },
    "variant": {
      "type": "string",
      "enum": [
        "dots",
        "lines",
        "swoosh",
        "vectors",
        "drops",
        "ripples",
        "fill",
        "shutter",
        "blind",
        "curtain",
        "garage",
        "gate",
        "awning",
        "window",
        "pump",
        "washer",
        "dryer",
        "dishwasher",
        "heat_pump"
      ],
      "description": "How the type draws its subject: wind (dots, lines, swoosh, vectors) and rain (drops, ripples, fill) make the whole poster the animated field; cover (shutter, blind, curtain, garage, gate, awning, window; default: the device class) and appliance (pump, washer, dryer, dishwasher, heat_pump) pick the drawing"
    },
    "direction": {
      "$ref": "#/$defs/input",
      "description": "wind, rain: the direction sensor (degrees or a compass point)"
    },
    "gust": {
      "$ref": "#/$defs/input",
      "description": "wind: the gust sensor"
    },
    "today": {
      "$ref": "#/$defs/input",
      "description": "rain, solar: today's total"
    },
    "wind": {
      "$ref": "#/$defs/input",
      "description": "rain: the wind speed that slants the drops"
    },
    "power": {
      "$ref": "defs.schema.json#/$defs/entityId",
      "description": "battery: its power, + charging"
    },
    "charge": {
      "$ref": "defs.schema.json#/$defs/entityId",
      "description": "battery: its charging power"
    },
    "discharge": {
      "$ref": "defs.schema.json#/$defs/entityId",
      "description": "battery: its discharging power"
    },
    "import": {
      "$ref": "defs.schema.json#/$defs/entityId",
      "description": "grid: the import meter"
    },
    "export": {
      "$ref": "defs.schema.json#/$defs/entityId",
      "description": "grid: the export meter"
    },
    "range": {
      "$ref": "#/$defs/input",
      "description": "car: its range"
    },
    "plugged": {
      "$ref": "#/$defs/input",
      "description": "car: plugged in"
    },
    "charging": {
      "$ref": "#/$defs/input",
      "description": "car: charging (a binary sensor, or power: on above 0)"
    },
    "location": {
      "$ref": "#/$defs/input",
      "description": "car: its device tracker"
    },
    "running_above": {
      "type": "number",
      "minimum": 0,
      "description": "appliance: the power (W) above which it runs"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trendEntity"
      },
      "description": "trend: the series, ids or objects (entity, name, color, rules, visibility)"
    },
    "status": {
      "description": "The status badge: its text (a template allowed), an object of badge keys with `value` for its text, or false for none. Default: the poster type's status, else the matching rule's label",
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/statusBadge"
        }
      ]
    },
    "badges": {
      "type": "array",
      "description": "The badges in the corner, in this order; `status` places the status badge (first unless placed). A badge without an entity reads the poster's: its attribute, else the poster's value",
      "items": {
        "oneOf": [
          {
            "const": "status"
          },
          {
            "$ref": "defs.schema.json#/$defs/entityId"
          },
          {
            "$ref": "#/$defs/badge"
          }
        ]
      }
    },
    "image": {
      "description": "The backdrop behind the whole poster: an image URL, a template, or an entity whose picture it shows (a camera, a media player, a person); false drops the poster type's own backdrop",
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "string"
        }
      ]
    },
    "icon_image": {
      "type": "string",
      "description": "A picture in the icon: an image URL, a template that renders one, or an entity whose picture it shows. Without a picture now, the icon is `icon`'s"
    },
    "image_opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.3,
      "description": "How much of the backdrop's picture shows through its shade, 0 to 1"
    },
    "image_tint": {
      "$ref": "defs.schema.json#/$defs/color",
      "description": "The colour of the shade over the backdrop's picture: a theme colour name, a hex or a var(). Default: the card's surface"
    },
    "image_blur": {
      "description": "Blurs the backdrop: true for the default blur, a number of px, false for a sharp picture. Default: a person's photo and a media player's cover art are blurred",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "visual": {
      "type": "string",
      "enum": ["sparkline", "columns", "strip", "bar", "gauge", "glow", "none"],
      "description": "The picture along the bottom: a plot of the history, a bar or a gauge of the value, glow (the poster lit from below in its colour, as strong as its level: min to max, a light's brightness, or on / off), or none. Default: the poster type's (a light glows); set, it replaces the type's picture"
    },
    "control_position": {
      "type": "string",
      "enum": ["end", "block"],
      "description": "Where the control sits: beside the value, or in a block under it. The icon's own actions are icon_tap_action / icon_hold_action"
    },
    "icon_ring": {
      "type": "boolean",
      "default": false,
      "description": "A ring of the value (min to max) around the icon"
    },
    "icon_tap_action": {
      "$ref": "defs.schema.json#/$defs/action",
      "description": "Run when the icon is tapped; toggle is the card's own (a lock locks or unlocks, an alarm panel arms or disarms, the rest switch). Default: none, a tap on the icon is the poster's"
    },
    "icon_hold_action": {
      "$ref": "defs.schema.json#/$defs/action",
      "description": "Run when the icon is held, a filling ring confirms it. Default: toggle on a lock and an alarm panel (none when it wants a code), else none"
    },
    "icon_double_tap_action": {
      "$ref": "defs.schema.json#/$defs/action",
      "description": "Run on a double tap of the icon"
    }
  },
  "required": ["type"],
  "allOf": [
    {
      "$ref": "#/$defs/posterKeys"
    },
    {
      "$ref": "entity.schema.json#/$defs/historyOptions"
    },
    {
      "$ref": "entity.schema.json#/$defs/actionDefaults"
    },
    {
      "$ref": "entity.schema.json#/$defs/haExtras"
    },
    {
      "$ref": "#/$defs/typeKeys"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "posterRule": {
      "type": "object",
      "description": "First matching rule wins, in the order written. Besides the colour, icon and label it changes the poster's icon and backdrop; a key it writes wins over the card's",
      "properties": {
        "state": {
          "$ref": "entity.schema.json#/$defs/rule/properties/state"
        },
        "below": {
          "$ref": "entity.schema.json#/$defs/rule/properties/below"
        },
        "above": {
          "$ref": "entity.schema.json#/$defs/rule/properties/above"
        },
        "color": {
          "$ref": "entity.schema.json#/$defs/rule/properties/color"
        },
        "icon": {
          "$ref": "entity.schema.json#/$defs/rule/properties/icon"
        },
        "label": {
          "$ref": "entity.schema.json#/$defs/rule/properties/label"
        },
        "tint_card": {
          "$ref": "entity.schema.json#/$defs/rule/properties/tint_card"
        },
        "style": {
          "$ref": "entity.schema.json#/$defs/rule/properties/style"
        },
        "pulse": {
          "$ref": "entity.schema.json#/$defs/rule/properties/pulse"
        },
        "icon_style": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/icon_style"
        },
        "icon_image": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "string"
            }
          ],
          "description": "A picture in the icon while the rule matches, or false for the icon"
        },
        "icon_ring": {
          "type": "boolean",
          "description": "A ring of the value around the icon"
        },
        "image": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "string"
            }
          ],
          "description": "The backdrop while the rule matches, or false for none"
        },
        "image_blur": {
          "$ref": "#/properties/image_blur"
        },
        "image_opacity": {
          "$ref": "#/properties/image_opacity"
        },
        "image_tint": {
          "$ref": "#/properties/image_tint"
        }
      },
      "anyOf": [
        {
          "required": ["state"]
        },
        {
          "required": ["below"]
        },
        {
          "required": ["above"]
        }
      ],
      "additionalProperties": false
    },
    "posterKeys": {
      "description": "The poster's item: an entity's keys, less the picture and the control's place, which are the poster's own (visual, control_position)",
      "type": "object",
      "properties": {
        "entity": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/entity"
        },
        "name": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/name"
        },
        "secondary": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/secondary"
        },
        "icon": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/icon"
        },
        "color": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/color"
        },
        "attribute": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/attribute"
        },
        "value": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/value"
        },
        "unit": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/unit"
        },
        "decimals": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/decimals"
        },
        "prefix": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/prefix"
        },
        "suffix": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/suffix"
        },
        "icon_style": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/icon_style"
        },
        "show_entity_picture": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/show_entity_picture"
        },
        "min": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/min"
        },
        "max": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/max"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/posterRule"
          }
        },
        "control": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/control"
        },
        "control_attribute": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/control_attribute"
        },
        "control_step": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/control_step"
        },
        "control_options": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/control_options"
        },
        "control_confirm": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/control_confirm"
        },
        "toggle": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/toggle"
        },
        "show_name": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/show_name"
        },
        "show_value": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/show_value"
        },
        "show_icon": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/show_icon"
        },
        "name_position": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/name_position"
        },
        "tap_action": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/tap_action"
        },
        "hold_action": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/hold_action"
        },
        "double_tap_action": {
          "$ref": "entity.schema.json#/$defs/entityKeys/properties/double_tap_action"
        },
        "hover": {
          "type": "boolean",
          "default": true,
          "description": "Home Assistant's hover and press, as on its tile card: a light layer under a mouse, a ripple from where you press, a ring around the card while it has the keyboard's focus. false keeps it still"
        }
      },
      "if": {
        "$ref": "entity.schema.json#/$defs/entityKeys/if"
      },
      "then": {
        "$ref": "entity.schema.json#/$defs/entityKeys/then"
      }
    },
    "posterType": {
      "type": "string",
      "enum": [
        "entity",
        "battery",
        "carbon_dioxide",
        "pm25",
        "pm10",
        "aqi",
        "weather",
        "sun",
        "wind",
        "rain",
        "trend",
        "light",
        "fan",
        "climate",
        "lock",
        "alarm_control_panel",
        "person",
        "media_player",
        "cover",
        "vacuum",
        "lawn_mower",
        "grid",
        "solar",
        "car",
        "appliance"
      ]
    },
    "badgeKeys": {
      "type": "object",
      "allOf": [
        {
          "$ref": "entity.schema.json#/$defs/entityKeys"
        }
      ],
      "properties": {
        "visibility": {
          "$ref": "defs.schema.json#/$defs/visibility"
        },
        "style": {
          "$ref": "entity.schema.json#/$defs/badgeStyle"
        },
        "size": {
          "$ref": "entity.schema.json#/$defs/badgeSize"
        },
        "format": {
          "type": "string",
          "enum": ["auto", "power", "duration", "relative"],
          "description": "How the value is written: as the entity formats it, in W / kW / MW, as a duration (1h 12m) or as the time from now of a date (in 38 minutes)"
        },
        "stale_after": {
          "type": ["number", "string"],
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(s|m|min|h|d)?\\s*$",
          "description": "Grey with its age when the entity has not reported for this long"
        },
        "trend_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "visual: trend, the hours it looks back"
        }
      }
    },
    "badge": {
      "description": "A badge in the poster's corner (an outline pill unless a style is set)",
      "allOf": [
        {
          "$ref": "#/$defs/badgeKeys"
        }
      ],
      "unevaluatedProperties": false
    },
    "statusBadge": {
      "description": "The status badge's keys (a tag without an icon unless set); `value` is its text",
      "allOf": [
        {
          "$ref": "#/$defs/badgeKeys"
        }
      ],
      "not": {
        "required": ["entity"]
      },
      "unevaluatedProperties": false
    },
    "input": {
      "description": "An entity id, or false for none (left out: found on the entity's device, or a weather entity's attribute)",
      "oneOf": [
        {
          "$ref": "defs.schema.json#/$defs/entityId"
        },
        {
          "const": false
        }
      ]
    },
    "trendEntity": {
      "oneOf": [
        {
          "$ref": "defs.schema.json#/$defs/entityId"
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "$ref": "defs.schema.json#/$defs/entityId"
            },
            "name": {
              "type": "string"
            },
            "color": {
              "$ref": "defs.schema.json#/$defs/color"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "entity.schema.json#/$defs/rule"
              }
            },
            "visibility": {
              "$ref": "defs.schema.json#/$defs/visibility"
            }
          },
          "required": ["entity"],
          "additionalProperties": false
        }
      ]
    },
    "typeKeys": {
      "description": "The keys each poster type takes: another type's are not allowed",
      "allOf": [
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "entity"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "battery"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "carbon_dioxide"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "pm25"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "pm10"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "aqi"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "weather"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "sun"
              }
            }
          },
          "then": {
            "properties": {
              "variant": false,
              "direction": false,
              "gust": false,
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "wind"
              }
            }
          },
          "then": {
            "properties": {
              "variant": {
                "enum": ["dots", "lines", "swoosh", "vectors"]
              },
              "today": false,
              "wind": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "rain"
              }
            }
          },
          "then": {
            "properties": {
              "variant": {
                "enum": ["drops", "ripples", "fill"]
              },
              "gust": false,
              "power": false,
              "charge": false,
              "discharge": false,
              "import": false,
              "export": false,
              "range": false,
              "plugged": false,
              "charging": false,
              "location": false,
              "running_above": false,
              "series": false
            }
          }
        },
        {
          "if": {
            "required": ["poster"],
            "properties": {
              "poster": {
                "const": "trend"
