{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malte-wessel.github.io/pro-cards/schema/defs.schema.json",
  "title": "Shared definitions for Pro Cards configs",
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
      "description": "Home Assistant entity id, e.g. sensor.outdoor_temperature"
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "description": "HA colour token (primary, accent, red, amber, blue-grey, …), hex, rgb()/hsl(), var(--x) or a Jinja template"
    },
    "icon": {
      "type": "string",
      "pattern": "^(mdi:[a-z0-9-]+|hass:[a-z0-9-]+|\\{\\{.*\\}\\}.*|.*\\{\\{.*)$",
      "description": "mdi:… icon or a Jinja template"
    },
    "numberish": {
      "type": ["number", "string"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "a number (numeric strings accepted)"
    },
    "visibilityCondition": {
      "description": "A Home Assistant visibility condition",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "state"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "entity": {
              "$ref": "#/$defs/entityId"
            },
            "entity_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/entityId"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/entityId"
                  },
                  "minItems": 1
                }
              ]
            },
            "attribute": {
              "type": "string"
            },
            "state": {
              "anyOf": [
                {
                  "type": ["string", "number", "boolean"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  },
                  "minItems": 1
                }
              ]
            },
            "state_not": {
              "anyOf": [
                {
                  "type": ["string", "number", "boolean"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["state"]
            },
            {
              "required": ["state_not"]
            }
          ],
          "description": "the entity (default: the item's own) is in / not in the given states"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "numeric_state"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "entity": {
              "$ref": "#/$defs/entityId"
            },
            "entity_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/entityId"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/entityId"
                  },
                  "minItems": 1
                }
              ]
            },
            "attribute": {
              "type": "string"
            },
            "above": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/numberish"
                },
                {
                  "$ref": "#/$defs/entityId"
                }
              ]
            },
            "below": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/numberish"
                },
                {
                  "$ref": "#/$defs/entityId"
                }
              ]
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["above"]
            },
            {
              "required": ["below"]
            }
          ],
          "description": "the entity's number (default: the item's own) is strictly above / below; a bound may be an entity id"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "screen"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "media_query": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["condition", "media_query"],
          "additionalProperties": false,
          "description": "a CSS media query matches the viewport"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "user"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "users": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": ["condition", "users"],
          "additionalProperties": false,
          "description": "the logged-in user is one of these user ids"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "location"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": ["condition", "locations"],
          "additionalProperties": false,
          "description": "the logged-in user's person is in one of these zones (home, not_home, a zone name)"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "time"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "after": {
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{2}(:\\d{2})?$"
            },
            "before": {
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{2}(:\\d{2})?$"
            },
            "weekdays": {
              "type": "array",
              "items": {
                "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
              },
              "minItems": 1
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "description": "the time of day is in the window (both ends included; before < after crosses midnight) and the weekday is listed"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "template"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "value_template": {
              "type": "string",
              "pattern": "\\{\\{|\\{%"
            }
          },
          "required": ["condition", "value_template"],
          "additionalProperties": false,
          "description": "the template renders true (true, yes, on, enable, 1 or a non-zero number)"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "and"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "conditions": {
              "$ref": "#/$defs/visibility"
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "description": "all of the conditions"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "or"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "conditions": {
              "$ref": "#/$defs/visibility"
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "description": "any of the conditions"
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "const": "not"
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            },
            "conditions": {
              "$ref": "#/$defs/visibility"
            }
          },
          "required": ["condition"],
          "additionalProperties": false,
          "description": "not all of the conditions"
        },
        {
          "type": "object",
          "description": "the legacy shape: state / state_not without condition (the entity defaults to the part's own)",
          "properties": {
            "entity": {
              "$ref": "#/$defs/entityId"
            },
            "entity_id": {
              "anyOf": [
                { "$ref": "#/$defs/entityId" },
                { "type": "array", "items": { "$ref": "#/$defs/entityId" }, "minItems": 1 }
              ]
            },
            "state": {
              "anyOf": [
                {
                  "type": ["string", "number", "boolean"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  },
                  "minItems": 1
                }
              ]
            },
            "state_not": {
              "anyOf": [
                {
                  "type": ["string", "number", "boolean"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  },
                  "minItems": 1
                }
              ]
            },
            "enabled": {
              "type": "boolean",
              "description": "false skips the condition"
            }
          },
          "anyOf": [
            {
              "required": ["state"]
            },
            {
              "required": ["state_not"]
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "visibility": {
      "description": "Show this part only while every condition holds (Home Assistant's visibility conditions); without it the part is always shown",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visibilityCondition"
          }
        },
        {
          "$ref": "#/$defs/visibilityCondition"
        }
      ]
    },
    "haCardExtras": {
      "description": "Keys Home Assistant adds to any card and applies itself; the cards read grid_options and layout_options only to know whether their rows are fixed, and then fill their cell",
      "grid_options": {
        "type": "object",
        "properties": {
          "columns": {
            "type": ["integer", "string"]
          },
          "rows": {
            "type": ["integer", "string"]
          },
          "min_columns": {
            "type": "integer"
          },
          "max_columns": {
            "type": "integer"
          },
          "min_rows": {
            "type": "integer"
          },
          "max_rows": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "visibility": {
        "type": "array"
      },
      "layout_options": {
        "type": "object"
      },
      "view_layout": {
        "type": "object"
      },
      "card_mod": {
        "type": "object"
      }
    },
    "action": {
      "description": "Home Assistant action config",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "more-info",
            "toggle",
            "navigate",
            "url",
            "perform-action",
            "call-service",
            "assist",
            "fire-dom-event",
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "more-info",
                "toggle",
                "navigate",
                "url",
                "perform-action",
                "call-service",
                "assist",
                "none"
              ]
            },
            "navigation_path": {
              "type": "string"
            },
            "navigation_replace": {
              "type": "boolean"
            },
            "url_path": {
              "type": "string"
            },
            "perform_action": {
              "type": "string",
              "pattern": "^[a-z_]+\\.[a-z_]+$"
            },
            "service": {
              "type": "string",
              "pattern": "^[a-z_]+\\.[a-z_]+$"
            },
            "data": {
              "type": "object"
            },
            "service_data": {
              "type": "object"
            },
            "target": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": ["string", "array"]
                },
                "device_id": {
                  "type": ["string", "array"]
                },
                "area_id": {
                  "type": ["string", "array"]
                },
                "floor_id": {
                  "type": ["string", "array"]
                },
                "label_id": {
                  "type": ["string", "array"]
                }
              },
              "additionalProperties": false
            },
            "entity": {
              "$ref": "#/$defs/entityId"
            },
            "confirmation": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "confirm_text": {
                      "type": "string"
                    },
                    "dismiss_text": {
                      "type": "string"
                    },
                    "exemptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "string"
                          }
                        },
                        "required": ["user"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "pipeline_id": {
              "type": "string",
              "description": "assist: the assist pipeline to use"
            },
            "start_listening": {
              "type": "boolean",
              "description": "assist: start listening right away"
            }
          },
          "required": ["action"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "navigate"
                  }
                }
              },
              "then": {
                "required": ["navigation_path"]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "url"
                  }
                }
              },
              "then": {
                "required": ["url_path"]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "perform-action"
                  }
                }
              },
              "then": {
                "required": ["perform_action"]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "call-service"
                  }
                }
              },
              "then": {
                "required": ["service"]
              }
            }
          ],
          "description": "Home Assistant runs the action (its frontend handles hass-action); fire-dom-event may carry any extra keys"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "fire-dom-event"
            }
          },
          "required": ["action"],
          "additionalProperties": true,
          "description": "fire-dom-event: every other key is passed to the DOM event (browser_mod etc.)"
        }
      ]
    }
  }
}
