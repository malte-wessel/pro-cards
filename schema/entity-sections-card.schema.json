{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malte-wessel.github.io/pro-cards/schema/entity-sections-card.schema.json",
  "title": "custom:entity-sections-card",
  "description": "Several groups of entities under one header, each section with its own layout. A section takes the same keys as an entity-group-card body plus divider.",
  "type": "object",
  "properties": {
    "type": { "const": "custom:entity-sections-card" },
    "title": { "type": "string", "description": "Header text. Template allowed." },
    "icon": {
      "$ref": "defs.schema.json#/$defs/icon",
      "description": "Header icon. Template allowed."
    },
    "header_entities": { "$ref": "entity.schema.json#/$defs/headerEntities" },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Default for grid sections"
    },
    "align": {
      "$ref": "entity.schema.json#/$defs/align",
      "description": "Default for every section"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "divider": {
            "type": "boolean",
            "default": false,
            "description": "Line above the section (never drawn for the first)"
          }
        },
        "required": ["entities"],
        "allOf": [{ "$ref": "entity.schema.json#/$defs/groupKeys" }],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["type", "sections"],
  "allOf": [
    { "$ref": "entity.schema.json#/$defs/itemOptions" },
    { "$ref": "entity.schema.json#/$defs/historyOptions" },
    { "$ref": "entity.schema.json#/$defs/actionDefaults" },
    { "$ref": "entity.schema.json#/$defs/haExtras" }
  ],
  "unevaluatedProperties": false
}
