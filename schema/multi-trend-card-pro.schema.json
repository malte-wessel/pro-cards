{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malte-wessel.github.io/pro-cards/schema/multi-trend-card-pro.schema.json",
  "title": "custom:multi-trend-card-pro",
  "description": "Tile-style trend graph for several numeric sensors with a hover/touch tooltip.",
  "type": "object",
  "properties": {
    "type": { "const": "custom:multi-trend-card-pro" },
    "title": { "type": "string", "description": "Default: first entity name" },
    "icon": { "$ref": "defs.schema.json#/$defs/icon" },
    "color": { "$ref": "defs.schema.json#/$defs/color", "description": "Header icon colour" },
    "hours_to_show": { "type": "number", "minimum": 1, "maximum": 168, "default": 6 },
    "smoothing_minutes": {
      "type": "number",
      "minimum": 5,
      "description": "Averaging bucket of the lines in minutes (default: one point per 12 px)"
    },
    "layout": {
      "type": "string",
      "enum": ["auto", "overlay", "lanes", "poster"],
      "default": "auto",
      "description": "auto = overlay when all units match, else lanes; poster = the entity card's poster: the icon and the window on top, the first value large, the lines overlaid along the bottom edge (no legend)"
    },
    "show_legend": { "type": "boolean", "default": true },
    "x_axis": {
      "type": "boolean",
      "default": false,
      "description": "Time labels + vertical gridlines"
    },
    "y_axis": {
      "type": "boolean",
      "default": false,
      "description": "Value labels + horizontal gridlines (per lane)"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "defs.schema.json#/$defs/entityId" },
          {
            "type": "object",
            "properties": {
              "entity": { "$ref": "defs.schema.json#/$defs/entityId" },
              "name": { "type": "string" },
              "color": {
                "$ref": "defs.schema.json#/$defs/color",
                "description": "Fixed colour of the series (or a template); wins over the rules"
              },
              "rules": {
                "type": "array",
                "items": { "$ref": "#/$defs/rule" },
                "description": "The first rule the current value matches colours the series"
              },
              "visibility": { "$ref": "defs.schema.json#/$defs/visibility" }
            },
            "required": ["entity"],
            "additionalProperties": false
          }
        ]
      }
    },
    "grid_options": { "$ref": "defs.schema.json#/$defs/haCardExtras/grid_options" },
    "fill_height": { "$ref": "defs.schema.json#/$defs/fillHeight" },
    "visibility": { "$ref": "defs.schema.json#/$defs/haCardExtras/visibility" },
    "layout_options": { "$ref": "defs.schema.json#/$defs/haCardExtras/layout_options" },
    "view_layout": { "$ref": "defs.schema.json#/$defs/haCardExtras/view_layout" },
    "card_mod": { "$ref": "defs.schema.json#/$defs/haCardExtras/card_mod" }
  },
  "required": ["type", "entities"],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "description": "A colour rule on the series' current value: state (text equality), below (exclusive) or above (inclusive). First match wins, in the order written.",
      "properties": {
        "state": { "type": ["string", "number", "boolean"] },
        "below": { "$ref": "defs.schema.json#/$defs/numberish" },
        "above": { "$ref": "defs.schema.json#/$defs/numberish" },
        "color": { "$ref": "defs.schema.json#/$defs/color" }
      },
      "required": ["color"],
      "anyOf": [{ "required": ["state"] }, { "required": ["below"] }, { "required": ["above"] }],
      "additionalProperties": false
    }
  }
}
